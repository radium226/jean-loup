#    #ninja -C build test
#}

package() {
    cd "${srcdir}/${pkgname%-rpi}-${pkgver%+*}"
    DESTDIR="${pkgdir}" ninja -C "build" install
    install -d -m 755 "${pkgdir}/usr/share/licenses/${pkgname%-rpi}"
    install -D -m 644 ./LICENSES/* "${pkgdir}/usr/share/licenses/${pkgname%-rpi}"/
    rm -rf "${pkgdir}/usr/share/doc/libcamera-0.0.0/html/.doctrees"
}